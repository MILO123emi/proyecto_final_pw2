<div class="container">
        <form id="donacionesForm" class="donaciones-box" method="GET" autocomplete="on">
            <h2>Choose a Service</h2>

            <div id="montosContainer" class="montos">
                <button type="button" data-monto="300">Manicure<br><small>L300</small></button>
                <button type="button" data-monto="500">Pedicure<br><small>L500</small></button>
                <button type="button" data-monto="800">Hair Styling<br><small>L800</small></button>
                <button type="button" data-monto="1500">Balayage<br><small>L1500</small></button>
            </div>

            <input type="text" id="monto" name="monto" placeholder="Choose a service" readonly>

            <div id="montoError"></div>

            <select id="donaciones-metodo" name="metodo">
                <option value="">Select payment method</option>
                <option value="card">Credit Card</option>
                <option value="paypal">PayPal</option>
            </select>

            <div id="metodoError"></div>

            <!-- CARD -->
            <div id="cardFields" class="payment-fields" style="display:none;">
                <input id="cardNumber" type="text" placeholder="Card Number">
                <input id="cardName" type="text" placeholder="Name on Card">
                <input id="cardExpiry" type="text" placeholder="MM/AA">
                <input id="cardCVV" type="text" placeholder="CVV">
            </div>

            <!-- PAYPAL -->
            <div id="paypalFields" class="payment-fields" style="display:none;">
                <input id="paypalEmail" name="email" type="email" placeholder="PayPal Email" autocomplete="email">
            </div>
            <div class="btn-pay">
                <button type="submit" id="btnDonar">Pay to Reserve Appointment</button>
            </div>

            <p id="donaciones-mensaje"></p>
        </form>
    </div>